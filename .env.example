# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Note: If no external MongoDB is running, the app automatically starts an embedded memory database
MONGODB_URI=mongodb://127.0.0.1:27017/sadguru_mart

# Authentication Security
JWT_SECRET=your_secret_key_change_in_production
JWT_EXPIRE=30d

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
